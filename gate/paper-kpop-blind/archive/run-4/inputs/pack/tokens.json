  "motion": {
    "timing": {
      "bpm": 88,
      "offset": 0.21,
      "bar": 4
    },
    "camera": {
      "moves": [
        "static",
        "push_in",
        "pull_back",
        "pan",
        "tilt",
        "orbit"
      ],
      "default": "static"
    },
    "easings": [
      "easeOut",
      "easeInOut",
      "easeIn",
      "backOut",
      "linear"
    ],
    "physics": [
      "ease",
      "squash",
      "overshoot",
      "anticipation"
    ],
    "transitions": [
      "cut",
      "iris",
      "wipe",
      "hold",
      "match_cut"
    ],
    "minShot": 1.2,
    "paper": {
      "squash": 0.12,
      "overshoot": 0.18,
      "anticipation": 0.1,
      "fibreBoilHz": 12
    }
  },
  "sound": {
    "music": "electronic pop: synth bass, clipped drums, brass stabs, vocal chops and a bright top line",
    "foley": "paper snap, tear, slap and whoosh; the foley is the material, not a cartoon sweetener",
    "silence": "one beat of silence before a drop; the close may hold on room tone",
    "voice": "optional; one short line per idea, never a lyric wall",
    "mix": "voice forward, music ducked about 4 dB, short bright reverb; delivery loudness belongs to the format",
    "assets": "none; music and voice are cleared per film"
  },
  "seed": {
    "seeded": [
      "paper fibre offset",
      "torn edge",
      "halftone phase",
      "sticker rotation",
      "grain offset"
    ],
    "fixed": [
      "palette",
      "type family",
      "recipe order",
      "camera direction"
    ],
    "jitterHz": 12
  }
