{
  "medium": {
    "brush": "no brush; every mark is a cut, a tear, a printed edge or a halftone dot",
    "material": "flat cut-paper collage on warm cream card: torn fibres, printed ink, halftone dots and visible cut edges; no gloss, no 3D, no photoreal material",
    "light": {
      "direction": "hard top-left key with no ambient fill; paper contact shadow is the open paper-shadow choice, while type always carries a hard misregistered ink shadow",
      "softness": 0.5,
      "opacity": 0.2,
      "paperShadow": "open choice paper-shadow: Collage gives every layer a soft contact shadow and a visible cut edge; Print keeps layers flat and gives only the type a hard offset shadow",
      "typeShadow": "hard misregistered ink shadow, fixed offset down and right, never softened"
    },
    "texture": 0.18,
    "hud": {
      "lyricBand": {
        "position": "bottom 14%",
        "form": "torn ink strip",
        "rule": "one content.caption line, eight words maximum; the band is behind the caption text"
      },
      "meter": {
        "position": "top right",
        "form": "black sticker",
        "readout": "acid"
      },
      "cornerMarks": "four short L marks inside the safe margins"
    },
    "layerOrder": [
      "paper",
      "background",
      "midground",
      "character",
      "foreground",
      "type",
      "hud",
      "fibre",
      "grain",
      "vignette"
    ]
  },
  "color": {
    "palettes": {
      "day-stage": {
        "paper": "#F2E8D5",
        "ink": "#171310",
        "red": "#E8452A",
        "blue": "#203FD8",
        "acid": "#D9F24B",
        "accent": "#F5B93F"
      },
      "night-stage": {
        "paper": "#E8DAC0",
        "ink": "#0C0A09",
        "red": "#B92A16",
        "blue": "#122A9B",
        "acid": "#D9F24B",
        "accent": "#FF5E9C"
      }
    },
    "roles": [
      "paper",
      "ink",
      "red",
      "blue",
      "acid",
      "accent"
    ],
    "default": "day-stage",
    "maxColours": 4
  },
  "type": {
    "families": [
      {
        "role": "display",
        "name": "Anton",
        "file": "fonts/Anton-Regular.ttf",
        "licence": "OFL 1.1"
      },
      {
        "role": "body",
        "name": "Archivo Black",
        "file": "fonts/ArchivoBlack-Regular.ttf",
        "licence": "OFL 1.1"
      },
      {
        "role": "caption",
        "name": "DM Mono",
        "file": "fonts/DMMono-Regular.ttf",
        "licence": "OFL 1.1"
      },
      {
        "role": "label",
        "name": "DM Mono",
        "file": "fonts/DMMono-Medium.ttf",
        "licence": "OFL 1.1"
      },
      {
        "role": "monogram",
        "name": "Permanent Marker",
        "file": "fonts/PermanentMarker-Regular.ttf",
        "licence": "OFL 1.1"
      }
    ],
    "scale": {
      "display": 64,
      "body": 26,
      "caption": 18,
      "label": 14,
      "monogram": 36,
      "displayLine": 0.85,
      "bodyLine": 1.05,
      "captionLine": 1.2
    },
    "treatment": {
      "edge": "cream cut edge on display and body letters, cut clean and never feathered",
      "shadow": "hard misregistered ink shadow with one fixed offset for the whole stack",
      "jitter": "per-character seeded jitter, answered by the seed block, never by chance",
      "boil": "12 Hz step boil, held on twos and never smoothed into a wobble",
      "accent": "one flat printed accent swatch in the accent role where a frame uses it, never a bevel or a reflection",
      "display": "ragged stacked display, each line broken where the paper would cut"
    }
  },
  "layout": {
    "shapes": [
      "card",
      "torn-strip",
      "sticker",
      "sunburst",
      "circle",
      "rule",
      "frame",
      "arrow",
      "burst"
    ],
    "margins": {
      "top": 0.06,
      "right": 0.06,
      "bottom": 0.12,
      "left": 0.06
    },
    "safeZones": [
      "title-safe 6 percent",
      "subject-safe central 88 percent",
      "lyric-safe bottom 14 percent",
      "meter-safe top right 18 percent",
      "type never crosses the 14 px floor at 390 px width"
    ],
    "maxWords": 8,
    "aspectScale": {
