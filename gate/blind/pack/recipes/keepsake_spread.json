{
  "id": "keepsake_spread",
  "beatRoles": [
    "portrait"
  ],
  "duration": {
    "min": 4,
    "max": 8,
    "default": 5.6
  },
  "camera": {
    "move": "static"
  },
  "slots": [
    "photos.hero",
    "content.caption"
  ],
  "assets": [
    "frame.page-edge",
    "texture.paper-fibre"
  ],
  "composition": [
    {
      "op": "layer",
      "id": "paper",
      "z": 0
    },
    {
      "op": "effect",
      "kind": "shadow",
      "z": 0,
      "opacity": 0.18
    },
    {
      "op": "image",
      "id": "hero",
      "slot": "photos.hero",
      "frame": "frame.page-edge",
      "align": "center",
      "x": 0.07,
      "y": 0.09,
      "w": 0.86,
      "h": 0.5
    },
    {
      "op": "shape",
      "id": "rule",
      "kind": "rule",
      "color": "clay",
      "align": "left",
      "x": 0.07,
      "y": 0.64,
      "w": 0.18,
      "h": 0.004
    },
    {
      "op": "text",
      "id": "caption",
      "slot": "content.caption",
      "typeRole": "caption",
      "align": "left",
      "x": 0.07,
      "y": 0.68,
      "w": 0.86,
      "h": 0.2
    },
    {
      "op": "effect",
      "kind": "fiber",
      "z": 3,
      "opacity": 0.12
    },
    {
      "op": "transition",
      "kind": "page_turn"
    }
  ],
  "transitionOut": "page_turn",
  "failureModes": [
    "caption longer than 18 words",
    "text over a face",
    "photograph below print resolution",
    "more than four colours in the frame",
    "a moving photograph"
  ]
}
