{
  "medium": {
    "brush": "flat brush, placeholder",
    "material": "warm off-white paper, placeholder",
    "light": {
      "direction": "top-left",
      "softness": 0.65,
      "opacity": 0.18
    },
    "texture": 0.12,
    "layerOrder": [
      "paper",
      "photo",
      "ink",
      "texture"
    ]
  },
  "color": {
    "palettes": {
      "warm-placeholder": {
        "paper": "#f4efe6",
        "ink": "#211d19",
        "accent": "#b4553c",
        "metal": "#b08a4f",
        "soft": "#e3d7c6",
        "shadow": "#3a332c"
      },
      "cool-placeholder": {
        "paper": "#eef1ee",
        "ink": "#1d2321",
        "accent": "#5f7a70",
        "metal": "#9aa79b",
        "soft": "#d7dfd8",
        "shadow": "#2f3833"
      }
    },
    "roles": [
      "paper",
      "ink",
      "accent",
      "metal",
      "soft",
      "shadow"
    ],
    "default": "warm-placeholder",
    "maxColours": 4
  },
  "type": {
    "families": [
      {
        "role": "display",
        "name": "Instrument Serif",
        "file": "assets/fonts/InstrumentSerif-Regular.ttf",
        "licence": "SIL Open Font License 1.1"
      },
      {
        "role": "monogram",
        "name": "Instrument Serif",
        "file": "assets/fonts/InstrumentSerif-Regular.ttf",
        "licence": "SIL Open Font License 1.1"
      },
      {
        "role": "body",
        "name": "Space Grotesk",
        "file": "assets/fonts/SpaceGrotesk.ttf",
        "licence": "SIL Open Font License 1.1"
      },
      {
        "role": "caption",
        "name": "Space Grotesk",
        "file": "assets/fonts/SpaceGrotesk.ttf",
        "licence": "SIL Open Font License 1.1"
      },
      {
        "role": "label",
        "name": "Space Grotesk",
        "file": "assets/fonts/SpaceGrotesk.ttf",
        "licence": "SIL Open Font License 1.1"
      }
    ],
    "scale": {
      "display": 72,
      "reading": 24,
      "small": 16,
      "label": 14,
      "monogram": 18
    }
  },
  "layout": {
    "shapes": [
      "rect",
      "arch"
    ],
    "margins": {
      "top": 0.07,
      "right": 0.07,
      "bottom": 0.08,
      "left": 0.07
    },
    "safeZones": [
      "title-safe 5 percent",
      "caption-safe bottom 12 percent"
    ],
    "maxWords": 18
  },
  "motion": {
    "timing": {
      "bpm": 72,
      "offset": 0,
      "bar": 4
    },
    "camera": {
      "moves": [
        "static",
        "push_in"
      ],
      "default": "push_in"
    },
    "easings": [
      "linear",
      "easeOut",
      "easeInOut"
    ],
    "physics": [
      "ease",
      "none"
    ],
    "transitions": [
      "cut",
      "page_turn",
      "dissolve",
      "hold"
    ],
    "minShot": 2
  },
  "sound": {
    "music": "room tone only, placeholder",
    "silence": "allowed",
    "note": "Replace this block or use an N/A block with a reason."
  },
  "seed": {
    "seeded": [
      "grain offset",
      "shadow offset",
      "camera phase",
      "timing jitter"
    ],
    "fixed": [
      "palette",
      "type family",
      "recipe order"
    ],
    "jitterHz": 0.5
  }
