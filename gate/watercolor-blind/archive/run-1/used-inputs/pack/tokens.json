{
  "medium": {
    "brush": "one loaded round brush for washes and forms; a rigger for stems, leader lines and labels; bristle tracks only on strokes wider than about 6 px; no pencil underdrawing and no vector outline",
    "material": "warm cotton watercolour paper, 300 gsm, visible fibre and slight buckling; the paper is the white and pure white is never painted",
    "light": {
      "direction": "ambient daylight from the top-left; paper vignette only, no cast shadow on forms",
      "softness": 0.95,
      "opacity": 0.08
    },
    "texture": 0.22,
    "layerOrder": [
      "paper",
      "far wash (parallax 0.25)",
      "mid wash (parallax 0.55)",
      "main form (parallax 1.0)",
      "foreground (parallax 1.55)",
      "annotation",
      "grain"
    ]
  },
  "color": {
    "palettes": {
      "garden-day": {
        "paper": "#f3ead9",
        "ink": "#2f2a24",
        "wash": "#9fb7a4",
        "petal": "#d9a6a0",
        "accent": "#c65438",
        "deep": "#6f7f74"
      },
      "evening-blue": {
        "paper": "#efe6d4",
        "ink": "#262a2e",
        "wash": "#8fa3b0",
        "petal": "#c9a27e",
        "accent": "#3f7fa8",
        "deep": "#5c6f7a"
      }
    },
    "roles": [
      "paper",
      "ink",
      "wash",
      "petal",
      "accent",
      "deep"
    ],
    "default": "garden-day",
    "maxColours": 5
  },
  "type": {
    "families": [
      {
        "role": "display",
        "name": "Cormorant Garamond",
        "file": "fonts/CormorantGaramond-Italic-Variable.ttf",
        "licence": "SIL Open Font License 1.1"
      },
      {
        "role": "body",
        "name": "Cormorant Garamond",
        "file": "fonts/CormorantGaramond-Variable.ttf",
        "licence": "SIL Open Font License 1.1"
      },
      {
        "role": "caption",
        "name": "Caveat",
        "file": "fonts/Caveat-Variable.ttf",
        "licence": "SIL Open Font License 1.1"
      },
      {
        "role": "label",
        "name": "IBM Plex Mono",
        "file": "fonts/IBMPlexMono-Regular.ttf",
        "licence": "SIL Open Font License 1.1"
      },
      {
        "role": "monogram",
        "name": "Cormorant Garamond",
        "file": "fonts/CormorantGaramond-Variable.ttf",
        "licence": "SIL Open Font License 1.1"
      }
    ],
    "scale": {
      "display": 64,
      "body": 28,
      "caption": 24,
      "label": 14,
      "monogram": 20
    }
  },
  "layout": {
    "shapes": [
      "paper",
      "wash",
      "blob",
      "stroke",
      "rule",
      "seal",
      "label"
    ],
    "margins": {
      "top": 0.09,
      "right": 0.08,
      "bottom": 0.11,
      "left": 0.08
    },
    "safeZones": [
      "subject-safe 8 percent",
      "caption-safe bottom 12 percent",
      "labels never cover the subject",
      "title lives in the top-left quiet zone"
    ],
    "maxWords": 16
  },
  "motion": {
    "timing": {
      "bpm": 48,
      "offset": 0,
      "bar": 4
    },
    "camera": {
      "moves": [
        "static",
        "pan",
        "tilt",
        "push_in",
        "pull_back",
        "parallax"
      ],
      "default": "pan"
    },
    "easings": [
      "linear",
      "easeOut",
      "easeInOut"
    ],
    "physics": [
      "ease",
      "none"
    ],
    "transitions": [
      "wipe",
      "page_turn",
      "hold"
    ],
    "minShot": 4
  },
  "sound": {
    "music": "solo felt piano, fingerpicked guitar, light strings, glockenspiel or kalimba; acoustic, unhurried; no drums",
    "foley": "paper brush rustle for each paint-in, pencil scratch for hand notes, a soft page turn, a quiet stamp thump",
    "silence": "the brush lifted: music out, paper and room only; use at the mist and before the close",
    "voice": "optional, warm, unhurried documentary read, one line per idea",
    "mix": "voice forward, music ducked about 4 dB, short soft reverb; delivery loudness belongs to the format",
    "assets": "none; music and voice are cleared per film"
  },
  "seed": {
    "seeded": [
      "stroke phase",
      "paper fibre offset",
      "wash-edge jitter",
      "paint-in order"
    ],
    "fixed": [
      "palette",
      "type family",
      "recipe order",
      "camera direction"
    ],
    "jitterHz": 0.4
  }
}
