{
  "id": "watercolor_mist",
  "beatRoles": [
    "transition"
  ],
  "duration": {
    "min": 4,
    "max": 7,
    "default": 5
  },
  "camera": {
    "move": "pull_back",
    "from": 1.0,
    "to": 0.98,
    "ease": "easeInOut"
  },
  "slots": [],
  "assets": [
    "set.journal-sheet",
    "texture.cotton-fibre",
    "frame.wash-edge"
  ],
  "composition": [
    {
      "op": "layer",
      "id": "paper",
      "z": 0
    },
    {
      "op": "shape",
      "id": "mist",
      "kind": "wash",
      "color": "paper",
      "x": 0,
      "y": 0.2,
      "w": 1,
      "h": 0.8,
      "opacity": 0.8,
      "z": 1
    },
    {
      "op": "path",
      "id": "rising-edge",
      "points": [
        [0, 0.5],
        [0.2, 0.46],
        [0.4, 0.52],
        [0.6, 0.47],
        [0.8, 0.53],
        [1, 0.49]
      ],
      "stroke": "paper",
      "opacity": 0.9,
      "z": 2
    },
    {
      "op": "effect",
      "kind": "fiber",
      "z": 6,
      "opacity": 0.22
    },
    {
      "op": "camera",
      "move": "pull_back",
      "from": 1.0,
      "to": 0.98,
      "ease": "easeInOut"
    },
    {
      "op": "transition",
      "kind": "wipe"
    }
  ],
  "transitionOut": "wipe",
  "failureModes": [
    "a caption during the mist",
    "a hard cut instead of a wash",
    "a vector cloud",
    "a mist that leaves a hard edge"
  ]
}
