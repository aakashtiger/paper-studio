{
  "medium": {
    "brush": "one loaded round brush for washes and forms; a rigger for stems, leader lines and labels; bristle tracks only on strokes wider than about 6 px; no pencil underdrawing and no vector outline",
    "material": "warm cotton watercolour paper, 300 gsm, visible fibre and slight buckling; the paper is the white and pure white is never painted",
    "light": {
      "direction": "ambient daylight from the top-left; paper vignette only, no cast shadow on forms",
      "softness": 0.95,
      "opacity": 0.08
    },
    "texture": 0.22,
    "granulation": 0.18,
    "strokeWidths": {
      "hairline": 1,
      "rigger": 1.5,
      "standard": 4,
      "wide": 8,
      "wash": 0
    },
    "layerOrder": [
      "paper",
      "far wash (parallax 0.25)",
      "mist band between far and mid",
      "mid wash (parallax 0.55)",
      "mist band between mid and main",
      "main form (parallax 1.0)",
      "foreground (parallax 1.55)",
      "annotation",
      "grain"
    ]
  },
  "color": {
    "palettes": {
      "garden-day": {
        "paper": "#f3ead9",
        "ink": "#2f2a24",
        "wash": "#9fb7a4",
        "petal": "#d9a6a0",
        "accent": "#c65438",
        "deep": "#9fb7a4"
      },
      "evening-blue": {
        "paper": "#efe6d4",
        "ink": "#262a2e",
        "wash": "#8fa3b0",
        "petal": "#c9a27e",
        "accent": "#c65438",
        "deep": "#8fa3b0"
      }
    },
    "roles": [
      "paper",
      "ink",
      "wash",
      "petal",
      "accent",
      "deep"
    ],
    "default": "garden-day",
    "maxColours": 5
  },
  "type": {
