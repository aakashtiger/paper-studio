  "clock": {
    "mode": "narration",
    "lines": [
      {
        "id": "v01",
        "text": "Uber does not own the cars, kitchens, or the freight it moves; it owns the network that connects them.",
        "start": 0,
        "duration": 5.6
      },
      {
        "id": "v02",
        "text": "Riders open the app, drivers use their own cars, and every completed trip is matched by the platform.",
        "start": 6.2,
        "duration": 5.2
      },
      {
        "id": "v03",
        "text": "Uber takes a service fee from every fare; the driver keeps the rest, and the platform keeps the match.",
        "start": 12,
        "duration": 5
      },
      {
        "id": "v04",
        "text": "The app sells delivery, freight, advertising and memberships, so one network earns in more than one way.",
        "start": 17.5,
        "duration": 5.8
      },
      {
        "id": "v05",
        "text": "More riders make each car busier, more drivers shorten the wait, and the network gets harder to leave.",
        "start": 23.7,
        "duration": 5.2
      }
    ]
  },
