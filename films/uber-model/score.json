  "captions": {
    "source": "films/uber-model/captions.srt",
    "lines": [
      {
        "id": "v01.1",
        "text": "Uber does not own the cars, kitchens, or",
        "start": 0,
        "end": 2.4
      },
      {
        "id": "v01.2",
        "text": "the freight it moves; it owns the network",
        "start": 2.4,
        "end": 4.8
      },
      {
        "id": "v01.3",
        "text": "that connects them.",
        "start": 4.8,
        "end": 5.6
      },
      {
        "id": "v02.1",
        "text": "Riders open the app, drivers use their own",
        "start": 6.2,
        "end": 8.5
      },
      {
        "id": "v02.2",
        "text": "cars, and every completed trip is matched by",
        "start": 8.5,
        "end": 10.8
      },
      {
        "id": "v02.3",
        "text": "the platform.",
        "start": 10.8,
        "end": 11.4
      },
      {
        "id": "v03.1",
        "text": "Uber takes a service fee from every fare;",
        "start": 12,
        "end": 14.1
      },
      {
        "id": "v03.2",
        "text": "the driver keeps the rest, and the platform",
        "start": 14.1,
        "end": 16.2
      },
      {
        "id": "v03.3",
        "text": "keeps the match.",
        "start": 16.2,
        "end": 17
      },
      {
        "id": "v04.1",
        "text": "The app sells delivery, freight, advertising and memberships,",
        "start": 17.5,
        "end": 20.2
      },
      {
        "id": "v04.2",
        "text": "so one network earns in more than one",
        "start": 20.2,
        "end": 22.7
      },
      {
        "id": "v04.3",
        "text": "way.",
        "start": 22.7,
        "end": 23.3
      },
      {
        "id": "v05.1",
        "text": "More riders make each car busier, more drivers",
        "start": 23.7,
        "end": 26
      },
      {
        "id": "v05.2",
        "text": "shorten the wait, and the network gets harder",
        "start": 26,
        "end": 28.3
      },
      {
        "id": "v05.3",
        "text": "to leave.",
        "start": 28.3,
        "end": 28.9
      }
    ]
  },
