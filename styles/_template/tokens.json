{
  "medium": {
    "brush": "flat brush, placeholder",
    "material": "warm off-white paper, placeholder",
    "light": {
      "direction": "top-left",
      "softness": 0.65,
      "opacity": 0.18
    },
    "texture": 0.12,
    "layerOrder": [
      "paper",
      "photo",
      "ink",
      "texture"
    ]
  },
  "color": {
    "palettes": {
      "warm-placeholder": {
        "paper": "#f4efe6",
        "ink": "#211d19",
        "accent": "#b4553c",
        "metal": "#b08a4f",
        "soft": "#e3d7c6",
        "shadow": "#3a332c"
      },
      "cool-placeholder": {
        "paper": "#eef1ee",
        "ink": "#1d2321",
        "accent": "#5f7a70",
        "metal": "#9aa79b",
        "soft": "#d7dfd8",
        "shadow": "#2f3833"
      }
    },
    "roles": [
      "paper",
      "ink",
      "accent",
      "metal",
      "soft",
      "shadow"
    ],
    "default": "warm-placeholder",
    "maxColours": 4
  },
  "type": {
    "families": [
      {
        "role": "display",
        "name": "Instrument Serif",
        "file": "assets/fonts/InstrumentSerif-Regular.ttf",
        "licence": "SIL Open Font License 1.1"
      },
      {
        "role": "monogram",
        "name": "Instrument Serif",
        "file": "assets/fonts/InstrumentSerif-Regular.ttf",
        "licence": "SIL Open Font License 1.1"
      },
      {
        "role": "body",
        "name": "Space Grotesk",
        "file": "assets/fonts/SpaceGrotesk.ttf",
        "licence": "SIL Open Font License 1.1"
      },
      {
        "role": "caption",
        "name": "Space Grotesk",
        "file": "assets/fonts/SpaceGrotesk.ttf",
        "licence": "SIL Open Font License 1.1"
      },
      {
        "role": "label",
        "name": "Space Grotesk",
        "file": "assets/fonts/SpaceGrotesk.ttf",
        "licence": "SIL Open Font License 1.1"
      }
    ],
    "scale": {
      "display": 72,
      "reading": 24,
      "small": 16,
      "label": 14,
      "monogram": 18
    }
  },
  "layout": {
    "shapes": [
      "rect",
      "arch"
    ],
    "margins": {
      "top": 0.07,
      "right": 0.07,
      "bottom": 0.08,
      "left": 0.07
    },
    "safeZones": [
      "title-safe 5 percent",
      "caption-safe bottom 12 percent"
    ],
    "maxWords": 18
  },
  "motion": {
    "timing": {
      "bpm": 72,
      "offset": 0,
      "bar": 4
    },
    "camera": {
      "moves": [
        "static",
        "push_in"
      ],
      "default": "push_in"
    },
    "easings": [
      "linear",
      "easeOut",
      "easeInOut"
    ],
    "physics": [
      "ease",
      "none"
    ],
    "transitions": [
      "cut",
      "page_turn",
      "dissolve",
      "hold"
    ],
    "minShot": 2
  },
  "sound": {
    "music": "room tone only, placeholder",
    "silence": "allowed",
    "note": "Replace this block or use an N/A block with a reason."
  },
  "seed": {
    "seeded": [
      "grain offset",
      "shadow offset",
      "camera phase",
      "timing jitter"
    ],
    "fixed": [
      "palette",
      "type family",
      "recipe order"
    ],
    "jitterHz": 0.5
  },
  "identity": {
    "envelope": {
      "canvas": [
        1920,
        1080
      ],
      "fps": 30,
      "dimension": "2.5d-layered",
      "cameraAxes": [
        "x",
        "y",
        "z",
        "roll",
        "shake"
      ]
    },
    "reference": "references/frames",
    "field": {
      "edgeBarMax": 0.08,
      "largestFlat": [
        0.04,
        0.46
      ],
      "warmShare": [
        0.4,
        0.9
      ],
      "blueShareMax": 0.2,
      "saturatedShare": [
        0.35,
        0.7
      ]
    },
    "composition": {
      "subjectHeight": [
        0.13,
        0.92
      ],
      "centroidX": [
        0.3,
        0.75
      ],
      "centroidShare": 0.8,
      "heightSdMin": 15,
      "heightTiersMin": 3,
      "localContrastMin": 20,
      "localContrastMedian": 35,
      "localContrastShare": 0.75
    },
    "cast": {
      "archetype": "performer",
      "stageRoles": [
        "star",
        "backing",
        "foil",
        "creature",
        "host"
      ],
      "principals": {
        "min": 0,
        "max": 0
      },
      "stagedShare": 0.85,
      "posesMin": 8,
      "expressionsMin": 14,
      "anchors": [
        "face",
        "hair",
        "hand-left",
        "hand-right",
        "foot-left",
        "foot-right"
      ],
      "appearance": {
        "faceStyle": "drawn-cartoon",
        "headLayers": 3,
        "hairLayers": 3,
        "bradMetal": "#C68E2E",
        "fingers": false
      }
    },
    "performance": {
      "modes": [
        "stage-show",
        "presenter-show",
        "creature-show"
      ],
      "defaultMode": "stage-show"
    },
    "motifs": {
      "library": [
        "sunburst",
        "paper-sun",
        "petal",
        "halo",
        "torn-strip",
        "tape",
        "stamp",
        "print-marks",
        "iris",
        "confetti",
        "speed-lines",
        "paperclip",
        "meter"
      ],
      "perFilm": {
        "min": 3,
        "max": 5
      },
      "uses": {
        "min": 2,
        "max": 5
      },
      "maxShotShare": 0.4,
      "semanticObjectMin": 1
    },
    "forbidden": [
      "glossy-3d",
      "photo-face",
      "soft-cast-shadow",
      "dof",
      "dissolve",
      "office-worker-lead",
      "static-no-creep",
      "camera-only-motion",
      "text-over-face",
      "lyric-wall"
    ]
  }
}
