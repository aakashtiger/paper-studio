{
  "medium": {
    "brush": "no brush; every mark is a cut, a tear, a printed edge or a halftone dot",
    "material": "flat cut-paper collage on warm cream card: torn fibres, printed ink, halftone dots and visible cut edges; no gloss, no 3D, no photoreal material",
    "light": {
      "direction": "hard top-left key with no ambient fill; paper contact shadow is the open paper-shadow choice, while type always carries a hard misregistered ink shadow",
      "softness": 0.5,
      "opacity": 0.2,
      "paperShadow": "open choice paper-shadow: Collage gives every layer a soft contact shadow and a visible cut edge; Print keeps layers flat with the same visible cut edge and gives only the type a hard offset shadow",
      "typeShadow": "hard misregistered ink shadow, fixed offset down and right, never softened"
    },
    "texture": 0.18,
    "hud": {
      "lyricBand": {
        "position": "bottom 14%",
        "form": "torn ink or red strip, role-tinted by the treatment",
        "rule": "one content.caption line, eight words maximum; the band is behind the caption text",
        "note": "The lyric band is a HUD exception to the 12% bottom text margin; the caption inside it is still eight words maximum."
      },
      "meter": {
        "position": "top right",
        "form": "black sticker",
        "readout": "beat count and four-role bar in DM Mono; the four roles come from the format palette field, default day-stage; not a content slot"
      },
      "cornerMarks": {
        "color": "ink",
        "weight": 1.5,
        "arm": 16,
        "position": "inside the screen safe margin"
      }
    },
    "layerOrder": [
      "paper",
      "background",
      "midground",
      "character",
      "foreground",
      "halftone",
      "hud",
      "type",
      "fibre",
      "grain",
      "vignette"
    ],
    "halftone": {
      "cellMin": 14,
      "cellMax": 22,
      "angle": 0.2,
      "dot": 0.55,
      "alpha": 0.5
    }
  },
