{
  "medium": {
    "brush": "flat brush, one dry pass, no visible bristle mark",
    "material": "warm off-white uncoated paper, 120 gsm, visible fibre, no coating",
    "light": {
      "direction": "top-left",
      "softness": 0.65,
      "opacity": 0.18
    },
    "texture": 0.12,
    "layerOrder": [
      "paper",
      "photograph",
      "ink",
      "fibre"
    ]
  },
  "color": {
    "palettes": {
      "sunday-paper": {
        "paper": "#f1e9dc",
        "ink": "#24201b",
        "clay": "#a9553f",
        "linen": "#ded2c0",
        "slate": "#8b857b",
        "umber": "#4a4036"
      },
      "winter-window": {
        "paper": "#eee8dd",
        "ink": "#232725",
        "clay": "#9c5a45",
        "linen": "#d8d2c6",
        "slate": "#7f8a84",
        "umber": "#39413c"
      }
    },
    "roles": [
      "paper",
      "ink",
      "clay",
      "linen",
      "slate",
      "umber"
    ],
    "default": "sunday-paper",
    "maxColours": 4
  },
  "type": {
    "families": [
      {
        "role": "display",
        "name": "Instrument Serif",
        "file": "fonts/InstrumentSerif-Regular.ttf",
        "licence": "SIL Open Font License 1.1"
      },
      {
        "role": "monogram",
        "name": "Instrument Serif",
        "file": "fonts/InstrumentSerif-Regular.ttf",
        "licence": "SIL Open Font License 1.1"
      },
      {
        "role": "body",
        "name": "Space Grotesk",
        "file": "fonts/SpaceGrotesk.ttf",
        "licence": "SIL Open Font License 1.1"
      },
      {
        "role": "caption",
        "name": "Space Grotesk",
        "file": "fonts/SpaceGrotesk.ttf",
        "licence": "SIL Open Font License 1.1"
      },
      {
        "role": "label",
        "name": "Space Grotesk",
        "file": "fonts/SpaceGrotesk.ttf",
        "licence": "SIL Open Font License 1.1"
      }
    ],
    "scale": {
      "display": 72,
      "body": 24,
      "caption": 14,
      "label": 14,
      "monogram": 18
    }
  },
  "layout": {
    "shapes": [
      "rect",
      "rule"
    ],
    "margins": {
      "top": 0.07,
      "right": 0.07,
      "bottom": 0.08,
      "left": 0.07
    },
    "safeZones": [
      "title-safe 5 percent",
      "caption-safe bottom 12 percent",
      "no text over a face"
    ],
    "maxWords": 18
  },
  "motion": {
    "timing": {
      "bpm": 60,
      "offset": 0,
      "bar": 4
    },
    "camera": {
      "moves": [
        "static",
        "push_in"
      ],
      "default": "static"
    },
    "easings": [
      "linear",
      "easeOut",
      "easeInOut"
    ],
    "physics": [
      "ease",
      "none"
    ],
    "transitions": [
      "page_turn",
      "hold"
    ],
    "minShot": 2
  },
  "sound": {
    "music": "none",
    "roomTone": "clock, kettle, chair, garden at low level",
    "silence": "preferred on the first and last spread",
    "voiceOver": "none"
  },
  "seed": {
    "seeded": [
      "grain offset",
      "shadow offset",
      "camera phase",
      "timing jitter"
    ],
    "fixed": [
      "palette",
      "type family",
      "recipe order",
      "page-turn direction"
    ],
    "jitterHz": 0.5
  }
}
